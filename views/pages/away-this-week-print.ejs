<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= pageTitle %></title>
    <style>
      body { font-family: Arial, sans-serif; margin: 24px; color: #111; }
      h1 { margin: 0 0 4px; font-size: 24px; }
      p { margin: 0 0 16px; color: #444; }
      table { width: 100%; border-collapse: collapse; margin-top: 12px; }
      th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
      th { background: #f3f4f6; }
      .meta { margin-bottom: 16px; font-size: 13px; color: #555; }
      @media print { .print-hide { display: none; } body { margin: 0; } }
    </style>
  </head>
  <body>
    <div class="print-hide" style="margin-bottom: 12px;">
      <button onclick="window.print()">Print</button>
    </div>
    <h1><%= fellowship.name %> — Away This Week</h1>
    <% if (session) { %>
      <p>Week: <%= weekLabel(session.week_start, session.week_end) %></p>
    <% } else { %>
      <p>No attendance session recorded yet.</p>
    <% } %>
    <div class="meta">Generated: <%= new Date(generatedAt).toLocaleString('en-GB') %></div>

    <% if (session && absentMembers.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Hostel / Room</th>
          </tr>
        </thead>
        <tbody>
          <% absentMembers.forEach((member, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= member.full_name %></td>
              <td><%= member.phone || '' %></td>
              <td><%= member.hostel || '' %><%= member.room_no ? ` / ${member.room_no}` : '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else if (session) { %>
      <p>No absentees recorded in the latest session.</p>
    <% } %>
  </body>
  </html>
