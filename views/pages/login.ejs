<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="container page narrow-page">
  <section class="card auth-card">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Secure Access</span>
        <h1>Login to the Member Database</h1>
        <p class="muted">Access the TAF member records, fellowship updates, and attendance reporting.</p>
      </div>
    </div>

    <form action="/login" method="post" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>
        <span>Email</span>
        <input type="email" name="email" required />
      </label>

      <label>
        <span>Password</span>
        <input type="password" name="password" required />
      </label>

      <button type="submit" class="button">Login</button>
    </form>

    <div class="hint-box">
      <strong>Seeded access</strong>
      <p>Super Admin: admin@teensaloud.local</p>
      <p>Fellowship Admin: gaza.admin@teensaloud.local</p>
      <p>Viewer: viewer@teensaloud.local</p>
      <p>Use the strong password values configured in your environment or .env file.</p>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
