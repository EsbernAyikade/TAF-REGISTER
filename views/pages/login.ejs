<%- include('../partials/head', { pageTitle, bodyClass: 'public-page' }) %>
  <header class="public-header">
    <div class="container public-header-inner">
      <a href="/login" class="brand brand-light" aria-label="Teens Aloud Foundation home">
        <img
          src="/images/ta-logo.jpg"
          alt="Teens Aloud Foundation logo"
          class="brand-logo"
          onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 58 58%22%3E%3Crect width=%2258%22 height=%2258%22 rx=%2214%22 fill=%22%230f5fd8%22/%3E%3Ctext x=%2229%22 y=%2238%22 font-family=%22Arial,sans-serif%22 font-size=%2224%22 font-weight=%22700%22 fill=%22white%22 text-anchor=%22middle%22%3ETA%3C/text%3E%3C/svg%3E'"
        />
        <div>
          <strong>Teens Aloud Foundation</strong>
          <span>Member Portal</span>
        </div>
      </a>
    </div>
  </header>

  <%- include('../partials/flash') %>

  <main class="container page auth-shell">
    <section class="card auth-card" aria-label="Login form">
      <div class="auth-brand">
        <span class="eyebrow">Secure Access</span>
        <h1>Enter the access password</h1>
      </div>

      <form action="/login" method="post" class="stack" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label>
          <span>Password</span>
          <div class="password-wrap">
            <input type="password" name="password" id="login-password" required autocomplete="current-password" placeholder="Enter your password" />
            <button type="button" class="password-toggle" aria-label="Show password" data-toggle-password="login-password">Show</button>
          </div>
        </label>

        <button type="submit" class="button button-accent">Log In</button>
      </form>

      <p class="fine-print">Need the password? Ask the person who manages your fellowship records.</p>
    </section>
  </main>

  <script>
    document.querySelectorAll('[data-toggle-password]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const input = document.getElementById(toggle.dataset.togglePassword);
        if (!input) return;
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        toggle.textContent = isPassword ? 'Hide' : 'Show';
        toggle.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
      });
    });
  </script>

<%- include('../partials/footer') %>
