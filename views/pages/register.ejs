<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="container page page-register">
  <section class="hero hero-register">
    <div>
      <span class="eyebrow">Registration Portal</span>
      <h1>Join Teens Aloud Foundation</h1>
      <p>
        Signed-in leaders can register members and have each record reviewed, approved, and managed by the
        Love Fellowship leadership team.
      </p>
      <ul class="feature-list">
        <li>Birthday tracking using day and month only</li>
        <li>Duplicate checks on name, phone, and email</li>
        <li>Admin approval before the record appears in the main directory</li>
      </ul>
    </div>
    <div class="hero-card">
      <img src="/images/love-fellowships.jpg" alt="Love Fellowships artwork" class="hero-image" />
      <p class="privacy-note">
        Privacy notice: submitted information is stored for pastoral care, fellowship
        administration, and attendance reporting. The searchable database is restricted to
        authorized users.
      </p>
    </div>
  </section>

  <section class="card">
    <div class="section-heading">
      <div>
        <h2>Member Registration Form</h2>
        <p>All fields marked in the form are used to support fellowship records and weekly attendance.</p>
      </div>
      <a href="/dashboard" class="button button-outline">Back to Dashboard</a>
    </div>

    <form action="/register" method="post" class="stack">
      <%- include('../partials/member-form', { member }) %>
      <div class="form-actions">
        <button type="submit" class="button">Submit Registration</button>
      </div>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
