<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="container page">
  <nav class="page-breadcrumbs" aria-label="Breadcrumb">
    <a href="/dashboard">Dashboard</a>
    <span class="divider">/</span>
    <a href="/members">Members</a>
    <span class="divider">/</span>
    <span>Add Member</span>
  </nav>

  <section class="section-heading">
    <div>
      <span class="eyebrow">Member Management</span>
      <h1>Add a New Member</h1>
      <p>Only a name and Love Fellowship are required — fill in whatever else you know.</p>
    </div>
    <a href="/members" class="button button-outline">Back to Directory</a>
  </section>

  <section class="card">
    <form action="/members/new" method="post" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <%- include('../partials/member-form', { member, showStatusField: true, showProgress: false }) %>
      <div class="form-actions">
        <button type="submit" class="button button-accent">Add Member</button>
      </div>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
