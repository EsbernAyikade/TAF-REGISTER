<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="container page">
  <section class="section-heading">
    <div>
      <span class="eyebrow">Directory</span>
      <h1>Member Database</h1>
      <p>Search, filter, add, and export member records.</p>
    </div>
    <div class="button-row">
      <a href="/members/new" class="button">Add Member</a>
      <a href="/exports/members.csv?<%= querystring %>" class="button button-outline">Export CSV</a>
      <a href="/exports/members.xlsx?<%= querystring %>" class="button">Export Excel</a>
    </div>
  </section>

  <%
    const activeFilterLabels = [];
    if (filters.search) activeFilterLabels.push({ label: `Search: ${filters.search}` });
    if (filters.fellowshipId) {
      const fellowshipMatch = fellowships.find((item) => Number(item.id) === Number(filters.fellowshipId));
      if (fellowshipMatch) activeFilterLabels.push({ label: `Fellowship: ${fellowshipMatch.name}` });
    }
    if (filters.gender) activeFilterLabels.push({ label: `Gender: ${filters.gender}` });
    if (filters.courseId) {
      const courseMatch = courses.find((item) => Number(item.id) === Number(filters.courseId));
      if (courseMatch) activeFilterLabels.push({ label: `Course: ${courseMatch.name}` });
    }
    if (filters.status) activeFilterLabels.push({ label: `Status: ${filters.status}` });
    if (filters.duplicateOnly) activeFilterLabels.push({ label: 'Possible duplicates only' });
  %>

  <% if (activeFilterLabels.length > 0) { %>
    <section class="filter-summary" aria-label="Active filters">
      <strong>Active filters</strong>
      <div class="chips">
        <% activeFilterLabels.forEach((filter) => { %>
          <span class="chip"><%= filter.label %></span>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="card">
    <form action="/members" method="get" class="filter-grid">
      <label>
        <span>Search</span>
        <input type="text" name="search" value="<%= filters.search %>" placeholder="Name, hostel, phone, email" />
      </label>

      <label>
        <span>Love Fellowship</span>
        <select name="fellowshipId">
          <option value="">All</option>
          <% fellowships.forEach((fellowship) => { %>
            <option value="<%= fellowship.id %>" <%= Number(filters.fellowshipId) === Number(fellowship.id) ? 'selected' : '' %>><%= fellowship.name %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Sub-ministry</span>
        <select name="subMinistryId">
          <option value="">All</option>
          <% subMinistries.forEach((item) => { %>
            <option value="<%= item.id %>" <%= Number(filters.subMinistryId) === Number(item.id) ? 'selected' : '' %>><%= item.name %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Gender</span>
        <select name="gender">
          <option value="">All</option>
          <% genderOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= filters.gender === option ? 'selected' : '' %>><%= option %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Course</span>
        <select name="courseId">
          <option value="">All</option>
          <% courses.forEach((course) => { %>
            <option value="<%= course.id %>" <%= Number(filters.courseId) === Number(course.id) ? 'selected' : '' %>><%= course.name %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Hostel</span>
        <input type="text" name="hostel" value="<%= filters.hostel %>" placeholder="Filter by hostel" />
      </label>

      <label>
        <span>Role</span>
        <select name="roleId">
          <option value="">All</option>
          <% allRoles.forEach((role) => { %>
            <option value="<%= role.id %>" <%= Number(filters.roleId) === Number(role.id) ? 'selected' : '' %>>
              <%= role.display_name %> (<%= role.role_type %>)
            </option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Level</span>
        <select name="level">
          <option value="">All</option>
          <% studyLevels.forEach((level) => { %>
            <option value="<%= level %>" <%= filters.level === level ? 'selected' : '' %>><%= level %></option>
          <% }) %>
        </select>
      </label>

      <label>
        <span>Status</span>
        <select name="status">
          <option value="">All</option>
          <% memberStatuses.forEach((status) => { %>
            <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option>
          <% }) %>
        </select>
      </label>

      <label class="checkbox-row">
        <input type="checkbox" name="duplicateOnly" value="1" <%= filters.duplicateOnly ? 'checked' : '' %> />
        <span>Possible duplicates only</span>
      </label>

      <div class="form-actions">
        <button type="submit" class="button">Apply Filters</button>
        <a href="/members" class="button button-outline">Reset</a>
      </div>
    </form>
  </section>

  <section class="card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Fellowship</th>
            <th>Role</th>
            <th>Course</th>
            <th>Level</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (members.length === 0) { %>
            <tr>
              <td colspan="7">
                <div class="empty-state">
                  <strong>No members match the selected filters</strong>
                  <p class="muted">Try clearing a filter or broadening your search.</p>
                  <a href="/members" class="button button-outline button-small">Clear filters</a>
                </div>
              </td>
            </tr>
          <% } %>
          <% members.forEach((member) => { %>
            <tr>
              <td data-label="Name">
                <a href="/members/<%= member.id %>"><%= member.full_name %></a>
                <% if (isNewMember(member.joined_at)) { %>
                  <span class="badge badge-info">New</span>
                <% } %>
                <% if (member.duplicate_flag) { %>
                  <div><span class="badge badge-warning">Duplicate flag</span></div>
                <% } %>
              </td>
              <td data-label="Fellowship">
                <% if (member.fellowship_slug) { %>
                  <a href="/fellowships/<%= member.fellowship_slug %>"><%= member.fellowship_name %></a>
                <% } else { %>
                  <%= member.fellowship_name %>
                <% } %>
              </td>
              <td data-label="Role"><%= member.role_name || 'Regular Member' %></td>
              <td data-label="Course"><%= member.course_name %></td>
              <td data-label="Level"><%= member.level %></td>
              <td data-label="Status">
                <span class="badge badge-<%= member.status === 'Active' ? 'success' : member.status === 'Inactive' ? 'warning' : 'info' %>">
                  <%= member.status %>
                </span>
              </td>
              <td data-label="Actions">
                <div class="button-row">
                  <a href="/members/<%= member.id %>" class="button button-small button-outline">View</a>
                  <% if (isManager) { %>
                    <a href="/members/<%= member.id %>/edit" class="button button-small">Edit</a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
