<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title><%= pageTitle %></title>
    <style>
      body{font-family:Arial,sans-serif;margin:18px}
      table{border-collapse:collapse;width:100%}
      th,td{border:1px solid #000;padding:6px;font-size:12px}
      th{background:#f0f0f0}
      @media print{button{display:none}}
    </style>
  </head>
  <body>
    <button onclick="window.print()">Print</button>
    <h1><%= fellowship.name %> Blank Register</h1>
    <table>
      <thead>
        <tr>
          <th>#</th><th>Name</th><th>Hostel</th><th>Room</th>
          <% weekColumns.forEach((w)=>{ %><th><%= w %></th><% }) %>
        </tr>
      </thead>
      <tbody>
        <% members.forEach((m, i)=>{ %>
          <tr>
            <td><%= i+1 %></td><td><%= m.full_name %></td><td><%= m.hostel || '' %></td><td><%= m.room_no || '' %></td>
            <% weekColumns.forEach(()=>{ %><td></td><% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </body>
  </html>
