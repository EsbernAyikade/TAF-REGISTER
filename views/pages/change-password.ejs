<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="container page narrow-page">
  <section class="card">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Settings</span>
        <h1>Change Access Password</h1>
        <p>Anyone using the app will need this new password the next time they sign in.</p>
      </div>
      <a href="/settings" class="button button-outline button-small">Back to settings</a>
    </div>

    <form action="/account/change-password" method="post" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>
        <span>New Access Password</span>
        <input type="password" name="password" required minlength="8" />
      </label>
      <label>
        <span>Confirm Access Password</span>
        <input type="password" name="confirmPassword" required minlength="8" />
      </label>
      <button type="submit" class="button">Update Password</button>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
