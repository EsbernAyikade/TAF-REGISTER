<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="container page">
  <section class="hero-panel">
    <div class="hero-copy">
      <span class="eyebrow">Dashboard</span>
      <h1>Keep the fellowship record book in motion.</h1>
      <p>See coverage, birthdays, and weekly attendance at a glance so the next service or follow-up starts with the right information.</p>
    </div>
    <div class="hero-actions">
      <a href="/members" class="button button-light">Members</a>
      <a href="/fellowships" class="button button-outline">Fellowships</a>
      <a href="/members/import" class="button button-outline">Import Register</a>
      <a href="/exports/members.xlsx" class="button button-outline">Export Excel</a>
    </div>
    <div class="hero-metrics">
      <div class="metric-pill">
        <strong><%= totalMembers %></strong>
        <span>Total Members</span>
      </div>
      <div class="metric-pill">
        <strong><%= birthdaysThisWeek.length %></strong>
        <span>Birthdays</span>
      </div>
      <div class="metric-pill">
        <strong><%= totalAttendanceThisWeek %></strong>
        <span>Present</span>
      </div>
    </div>
  </section>

  <section class="stats-grid">
    <article class="stat-card accent-blue">
      <span>Total Members</span>
      <strong><%= totalMembers %></strong>
      <small>Active roster</small>
    </article>
    <article class="stat-card accent-orange">
      <span>Birthdays This Week</span>
      <strong><%= birthdaysThisWeek.length %></strong>
      <small>Celebrate members</small>
    </article>
    <article class="stat-card accent-slate">
      <span>Week Range</span>
      <strong><%= formatDate(currentWeekStart) %></strong>
      <small>to <%= formatDate(currentWeekEnd) %></small>
    </article>
    <article class="stat-card accent-green">
      <span>Attendance This Week</span>
      <strong><%= totalAttendanceThisWeek %></strong>
      <small>Total present marks saved</small>
    </article>
  </section>

  <section class="two-column">
    <article class="card">
      <div class="section-heading">
        <div>
          <h2>Weekly Attendance Report</h2>
          <p>Cross-fellowship turnout for the current week.</p>
        </div>
      </div>

      <% if (attendanceSummary.length === 0) { %>
        <div class="empty-state">
          <strong>No attendance data yet</strong>
          <p class="muted">Attendance comparisons will appear once fellowships start marking weeks.</p>
        </div>
      <% } else { %>
        <div class="trend-list attendance-chart">
          <% attendanceSummary.forEach((item) => { %>
            <div class="trend-row">
              <div class="trend-meta">
                <strong><a href="/fellowships/<%= item.slug %>"><%= item.name.replace(' Love Fellowship', '') %></a></strong>
                <span><%= item.present_total %> of <%= item.member_total %> (<%= item.rate %>%)</span>
              </div>
              <div class="trend-bar">
                <span style="width: <%= item.rate %>%"></span>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Love Fellowship</th>
                <th>Present</th>
                <th>Members</th>
                <th>Rate</th>
              </tr>
            </thead>
            <tbody>
              <% attendanceSummary.forEach((item) => { %>
                <tr>
                  <td data-label="Love Fellowship"><a href="/fellowships/<%= item.slug %>"><%= item.name %></a></td>
                  <td data-label="Present"><%= item.present_total %></td>
                  <td data-label="Members"><%= item.member_total %></td>
                  <td data-label="Rate"><%= item.rate %>%</td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </article>

    <article class="card">
      <div class="section-heading">
        <div>
          <h2>Birthdays This Week</h2>
          <p>Celebrate members whose birthdays are coming up.</p>
        </div>
      </div>
      <div class="list-stack">
        <% if (birthdaysThisWeek.length === 0) { %>
          <p class="muted">No upcoming birthdays recorded this week.</p>
        <% } %>
        <% birthdaysThisWeek.forEach((birthday) => { %>
          <div class="list-item">
            <div>
              <strong><a href="/members/<%= birthday.id %>"><%= birthday.full_name %></a></strong>
              <p><%= birthday.fellowship_name %> · <%= formatBirthday(birthday.birth_day, birthday.birth_month) %></p>
            </div>
            <span class="badge badge-info"><%= birthday.diffDays === 0 ? 'Today' : `${birthday.diffDays} day(s)` %></span>
          </div>
        <% }) %>
      </div>
    </article>
  </section>

  <section class="three-column">
    <article class="card">
      <h2>Members by Fellowship</h2>
      <div class="list-stack">
        <% fellowshipStats.forEach((item) => { %>
          <div class="list-item">
            <span><a href="/fellowships/<%= item.slug %>"><%= item.name %></a></span>
            <strong><%= item.count %></strong>
          </div>
        <% }) %>
      </div>
    </article>

    <article class="card">
      <h2>Gender Distribution</h2>
      <div class="list-stack">
        <% genderStats.forEach((item) => { %>
          <div class="list-item">
            <span><%= item.gender %></span>
            <strong><%= item.count %></strong>
          </div>
        <% }) %>
      </div>
    </article>

    <article class="card">
      <h2>Sub-ministry Split</h2>
      <div class="list-stack">
        <% subMinistryStats.forEach((item) => { %>
          <div class="list-item">
            <span><%= item.name %></span>
            <strong><%= item.count %></strong>
          </div>
        <% }) %>
      </div>
    </article>
  </section>

  <section class="card">
    <div class="section-heading">
      <div>
        <h2>Birthdays This Month</h2>
        <p>Month-at-a-glance reminder for leaders and welfare teams.</p>
      </div>
    </div>
    <div class="chips">
      <% birthdaysThisMonth.forEach((birthday) => { %>
        <span class="chip"><%= birthday.full_name %> · <%= formatBirthday(birthday.birth_day, birthday.birth_month) %></span>
      <% }) %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
