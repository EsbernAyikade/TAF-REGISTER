<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="container page">
  <section class="section-heading">
    <div>
      <span class="eyebrow">Member Record</span>
      <h1><%= member.full_name %> <% if (isNew) { %><span class="badge badge-info">New</span><% } %></h1>
      <p><%= member.fellowship_name || 'No Fellowship' %> · <%= member.role_name || 'Regular Member' %></p>
    </div>
    <% if (canManage) { %>
      <div class="button-row">
        <a href="/members/<%= member.id %>/edit" class="button">Edit Record</a>
      </div>
    <% } %>
  </section>

  <section class="two-column">
    <article class="card" id="attendance-history">
      <h2>Member Information</h2>
      <dl class="detail-grid">
        <div><dt>Gender</dt><dd><%= member.gender || '—' %></dd></div>
        <div><dt>Birthday</dt><dd><%= formatBirthday(member.birth_day, member.birth_month) %></dd></div>
        <div><dt>Hostel</dt><dd><%= member.hostel || '—' %></dd></div>
        <div><dt>Room No.</dt><dd><%= member.room_no || '—' %></dd></div>
        <div><dt>Course</dt><dd><%= member.course_name || '—' %></dd></div>
        <div><dt>Sub-ministry</dt><dd><%= member.sub_ministry_name || 'None' %></dd></div>
        <div><dt>Phone</dt><dd><%= member.phone || '—' %></dd></div>
        <div><dt>Email</dt><dd><%= member.email || '—' %></dd></div>
        <div><dt>Level</dt><dd><%= member.level || '—' %></dd></div>
        <div><dt>Status</dt><dd><%= member.status %></dd></div>
        <div><dt>Date Joined</dt><dd><%= formatDate(member.joined_at) %></dd></div>
      </dl>
      <% if (member.duplicate_flag && member.duplicate_notes) { %>
        <div class="notice-box warning-box">
          <strong>Possible duplicate detected</strong>
          <p><%= member.duplicate_notes %></p>
          <% if (canManage) { %>
            <form action="/members/<%= member.id %>/merge" method="post" class="stack">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label>
                <span>Duplicate member ID to merge into this record</span>
                <input type="number" name="duplicateMemberId" min="1" required />
              </label>
              <button type="submit" class="button button-small">Merge duplicate into this member</button>
            </form>
          <% } %>
        </div>
      <% } %>

      <% if (canManage) { %>
        <div class="notice-box">
          <strong>Transfer Fellowship</strong>
          <form action="/members/<%= member.id %>/transfer" method="post" class="stack">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>
              <span>Move to Love Fellowship</span>
              <select name="toFellowshipId" required>
                <option value="">Select fellowship</option>
                <% fellowships.forEach((f) => { %>
                  <option value="<%= f.id %>" <%= Number(member.fellowship_id) === Number(f.id) ? 'disabled' : '' %>><%= f.name %></option>
                <% }) %>
              </select>
            </label>
            <label>
              <span>Notes (optional)</span>
              <input type="text" name="notes" placeholder="Reason for transfer" />
            </label>
            <button type="submit" class="button button-outline button-small">Transfer member</button>
          </form>
        </div>
      <% } %>

      <% if (transferHistory && transferHistory.length > 0) { %>
        <div class="notice-box">
          <strong>Fellowship Transfer History</strong>
          <div class="list-stack">
            <% transferHistory.forEach((entry) => { %>
              <div class="list-item">
                <span><%= entry.from_fellowship_name || 'No Fellowship' %> → <%= entry.to_fellowship_name || 'No Fellowship' %></span>
                <small><%= formatDate(entry.created_at) %></small>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </article>

    <article class="card">
      <h2>Attendance Snapshot</h2>
      <div class="stats-grid single-column">
        <article class="stat-card">
          <span>Attendance Rate</span>
          <strong><%= attendanceStats.attendance_rate || attendanceStats.rate %>%</strong>
        </article>
        <article class="stat-card">
          <span>Weeks Attended</span>
          <strong><%= attendanceStats.attended_weeks %></strong>
        </article>
        <article class="stat-card">
          <span>Weeks Missed</span>
          <strong><%= attendanceStats.missed_weeks %></strong>
        </article>
      </div>

      <% if (attendanceHistory.length > 0) { %>
        <div class="attendance-insights">
          <article class="mini-stat">
            <span>Longest streak</span>
            <strong><%= attendanceStats.longest_attendance_streak || 0 %> W</strong>
          </article>
          <article class="mini-stat">
            <span>Longest absence</span>
            <strong><%= attendanceStats.longest_absence_streak || 0 %> W</strong>
          </article>
          <article class="mini-stat">
            <span>First week</span>
            <strong><%= attendanceStats.first_week ? weekLabel(attendanceStats.first_week, new Date(new Date(attendanceStats.first_week + 'T00:00:00Z').getTime() + 6*86400000).toISOString().slice(0,10)) : '—' %></strong>
          </article>
          <article class="mini-stat">
            <span>Most recent</span>
            <strong><%= attendanceStats.most_recent_week ? weekLabel(attendanceStats.most_recent_week, new Date(new Date(attendanceStats.most_recent_week + 'T00:00:00Z').getTime() + 6*86400000).toISOString().slice(0,10)) : '—' %></strong>
          </article>
        </div>

        <div class="attendance-months">
          <% attendanceGroups.forEach((group) => { %>
            <div class="month-group">
              <div class="month-group-header">
                <h3><%= group.label %></h3>
                <span><%= group.entries.filter((entry) => entry.present === 1).length %> present</span>
              </div>
              <div class="attendance-grid">
                <% group.entries.forEach((entry) => { %>
                  <span
                    class="attendance-cell <%= entry.present === 1 ? 'present' : entry.present === 0 ? 'absent' : 'neutral' %>"
                    title="<%= weekLabel(entry.week_start, entry.week_end) %> — <%= entry.present === 1 ? 'Present' : entry.present === 0 ? 'Absent' : 'No session' %>"
                  ></span>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted">No attendance has been recorded for this fellowship yet.</p>
      <% } %>

      <div class="list-stack">
        <% if (attendanceHistory.length > 0) { %>
          <% attendanceHistory.forEach((entry) => { %>
            <div class="list-item">
              <span><%= weekLabel(entry.week_start, entry.week_end) %></span>
              <span class="badge badge-<%= entry.present === 1 ? 'success' : entry.present === 0 ? 'danger' : 'neutral' %>">
                <%= entry.present === 1 ? 'Present' : entry.present === 0 ? 'Absent / Not marked' : 'No session' %>
              </span>
            </div>
          <% }) %>
        <% } %>
      </div>

      <% if (attendanceByFellowship && attendanceByFellowship.length > 0) { %>
        <div class="notice-box">
          <strong>Attendance by Fellowship Segment</strong>
          <div class="list-stack">
            <% attendanceByFellowship.forEach((entry) => { %>
              <div class="list-item">
                <span><%= entry.fellowship_name %> · <%= weekLabel(entry.week_start, entry.week_end) %></span>
                <span class="badge badge-<%= entry.present === 1 ? 'success' : entry.present === 0 ? 'danger' : 'neutral' %>">
                  <%= entry.present === 1 ? 'Present' : entry.present === 0 ? 'Absent / Not marked' : 'No session' %>
                </span>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </article>
  </section>
</main>

<%- include('../partials/footer') %>
