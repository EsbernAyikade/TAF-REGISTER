<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="container page">
  <nav class="page-breadcrumbs" aria-label="Breadcrumb">
    <a href="/dashboard">Dashboard</a>
    <span class="divider">/</span>
    <a href="/fellowships">Fellowships</a>
    <span class="divider">/</span>
    <span><%= fellowship.name %></span>
  </nav>

  <section class="section-heading">
    <div>
      <span class="eyebrow">Love Fellowship</span>
      <h1><%= fellowship.name %></h1>
      <p>Leadership, member records, stats, and weekly turnout for this branch.</p>
    </div>
    <div class="button-row">
      <a href="/members?fellowshipId=<%= fellowship.id %>" class="button button-outline">View Directory Slice</a>
      <a href="/members/import" class="button button-outline">Import Register</a>
      <% if (canManage) { %>
        <a href="/fellowships/<%= fellowship.slug %>/attendance" class="button button-accent">Mark Attendance</a>
      <% } %>
    </div>
  </section>

  <section class="stats-grid">
    <article class="stat-card"><span>Total Members</span><strong><%= stats.totalMembers %></strong></article>
    <article class="stat-card"><span>Male</span><strong><%= stats.maleMembers %></strong></article>
    <article class="stat-card"><span>Female</span><strong><%= stats.femaleMembers %></strong></article>
    <% if (stats.unspecifiedGenderMembers > 0) { %>
      <article class="stat-card"><span>Unspecified</span><strong><%= stats.unspecifiedGenderMembers %></strong></article>
    <% } %>
    <article class="stat-card"><span>Attendance This Week</span><strong><%= attendanceHeadline ? attendanceHeadline.present_total : 0 %></strong></article>
  </section>

  <section class="two-column">
    <article class="card">
      <h2>Leadership Team</h2>
      <div class="leadership-grid">
        <div>
          <h3>Executives</h3>
          <% if (leaders.executives.length === 0) { %><p class="muted">No executives assigned.</p><% } %>
          <% leaders.executives.forEach((member) => { %>
            <div class="list-item compact">
              <span><a href="/members/<%= member.id %>"><%= member.full_name %></a></span>
              <strong><%= member.role_name %></strong>
            </div>
          <% }) %>
        </div>
        <div>
          <h3>Directors</h3>
          <% if (leaders.directors.length === 0) { %><p class="muted">No directors assigned.</p><% } %>
          <% leaders.directors.forEach((member) => { %>
            <div class="list-item compact">
              <span><a href="/members/<%= member.id %>"><%= member.full_name %></a></span>
              <strong><%= member.role_name %></strong>
            </div>
          <% }) %>
        </div>
        <div>
          <h3>Reps</h3>
          <% if (leaders.reps.length === 0) { %><p class="muted">No reps assigned.</p><% } %>
          <% leaders.reps.forEach((member) => { %>
            <div class="list-item compact">
              <span><a href="/members/<%= member.id %>"><%= member.full_name %></a></span>
              <strong><%= member.role_name %></strong>
            </div>
          <% }) %>
        </div>
      </div>
    </article>

    <article class="card">
      <h2>Weekly Attendance Trend</h2>
      <p class="muted">
        <%= attendanceHeadline ? attendanceHeadline.headline : `No attendance captured yet for ${fellowship.name}.` %>
      </p>
      <div class="trend-list">
        <% if (trend.length === 0) { %><p class="muted">No attendance history yet.</p><% } %>
        <% trend.forEach((entry) => { %>
          <div class="trend-row">
            <div class="trend-meta">
              <strong><%= entry.label %></strong>
              <span><%= entry.present_total %> present</span>
            </div>
            <div class="trend-bar">
              <span style="width: <%= entry.percentage %>%"></span>
            </div>
          </div>
        <% }) %>
      </div>
    </article>
  </section>

  <section class="two-column">
    <article class="card">
      <div class="section-heading">
        <div>
          <h2>Going Quiet (3+ missed weeks)</h2>
          <p>Members currently on consecutive absence streaks.</p>
        </div>
      </div>
      <div class="list-stack">
        <% if (!goingQuietMembers || goingQuietMembers.length === 0) { %>
          <p class="muted">No one currently meets the 3+ week absence threshold.</p>
        <% } %>
        <% (goingQuietMembers || []).forEach((member) => { %>
          <div class="list-item">
            <strong><a href="/members/<%= member.id %>#attendance-history"><%= member.full_name %></a></strong>
            <span class="badge badge-warning"><%= member.absenceStreak %> weeks</span>
          </div>
        <% }) %>
      </div>
    </article>

    <article class="card">
      <div class="section-heading">
        <div>
          <h2>Away This Week</h2>
          <p>Latest attendance session absentees.</p>
        </div>
        <a href="/fellowships/<%= fellowship.slug %>/away-this-week" class="button button-small button-outline">Open full list</a>
      </div>
      <% if (!awayThisWeek.session) { %>
        <p class="muted">No attendance session has been recorded yet.</p>
      <% } else { %>
        <p class="muted">
          Week: <%= weekLabel(awayThisWeek.session.week_start, awayThisWeek.session.week_end) %> ·
          <strong><%= awayThisWeek.absentMembers.length %></strong> absent
        </p>
        <div class="list-stack">
          <% if (awayThisWeek.absentMembers.length === 0) { %>
            <p class="muted">No absentees in the latest recorded week.</p>
          <% } %>
          <% awayThisWeek.absentMembers.slice(0, 8).forEach((member) => { %>
            <div class="list-item">
              <strong><a href="/members/<%= member.id %>#attendance-history"><%= member.full_name %></a></strong>
              <span><%= member.phone || 'No phone' %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </article>
  </section>

  <section class="card">
    <div class="section-heading">
      <div>
        <h2>Members</h2>
        <p>Members belonging to this Love Fellowship.</p>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th>Sub-ministry</th>
            <th>Course</th>
            <th>Level</th>
          </tr>
        </thead>
        <tbody>
          <% if (members.length === 0) { %>
            <tr>
              <td colspan="5">
                <div class="empty-state">
                  <strong>No members yet</strong>
                  <p class="muted">Members assigned to this Love Fellowship will show up here.</p>
                </div>
              </td>
            </tr>
          <% } %>
          <% members.forEach((member) => { %>
            <tr>
              <td data-label="Name"><a href="/members/<%= member.id %>"><%= member.full_name %></a></td>
              <td data-label="Role"><%= member.role_name || 'Regular Member' %></td>
              <td data-label="Sub-ministry"><%= member.sub_ministry_name || 'None' %></td>
              <td data-label="Course"><%= member.course_name %></td>
              <td data-label="Level"><%= member.level %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
