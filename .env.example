# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production (e.g. Render), set these as real environment variables in
# the hosting dashboard instead — never commit real secrets to git.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Local development uses SQLite by default. Set DATABASE_URL to use PostgreSQL
# (including Neon) locally; production refuses to start without DATABASE_URL.
DATA_DIR=./data
DATABASE_PATH=./data/teens-aloud.db
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# A long, random string. Required in production — the app will refuse to
# start without it. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-local-session-secret

# Shared access password for the whole app. Required in production — the app
# will refuse to start if it is missing.
SHARED_ACCESS_PASSWORD=change-me-strong-password
