# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production (e.g. Render), set these as real environment variables in
# the hosting dashboard instead — never commit real secrets to git.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Where the SQLite database file lives. In production this MUST point inside
# a persistent disk mount (e.g. /var/data on Render), or data will be lost
# on every redeploy/restart.
DATA_DIR=./data
DATABASE_PATH=./data/teens-aloud.db

# A long, random string. Required in production — the app will refuse to
# start without it. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-local-session-secret

# Seeded account credentials. All four are REQUIRED in production — the app
# will refuse to start if any is missing, rather than silently falling back
# to a hardcoded password. Every seeded account must change its password on
# first login regardless.
SUPER_ADMIN_EMAIL=admin@teensaloud.local
SUPER_ADMIN_PASSWORD=change-me-strong-password
DEFAULT_USER_PASSWORD=change-me-strong-password
FELLOWSHIP_ADMIN_PASSWORD=change-me-strong-password
VIEWER_PASSWORD=change-me-strong-password
